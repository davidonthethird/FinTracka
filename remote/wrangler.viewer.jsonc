{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fintracka-viewer",
  "main": "src/viewer.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "../frontend/dist-viewer",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "fintracka-viewer-staging",
      "workers_dev": true,
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "fintracka-snapshots-staging" }],
      "d1_databases": [{
        "binding": "COMMANDS",
        "database_name": "fintracka-mobile-commands-staging",
        "database_id": "70d7630f-8a2c-46d2-a797-e946031e5fac",
        "migrations_dir": "migrations"
      }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://hidden-silence-257f.cloudflareaccess.com",
        "ACCESS_USER_AUD": "25b2f01ecff268bc527f6dce6b2cec9cbbdd216dd6a4d8208eaa03d31f65fe39",
        "ACCESS_MAC_AUD": "0bdc62491b666aee9f39710c9b69b17cbdeccae87951fc3515a7c637da32d386",
        "HOUSEHOLD_ID": "fintracka-household-v1",
        "HOUSEHOLD_NAME": "FinTracka household"
      }
    },
    "production": {
      "name": "fintracka-viewer-production",
      "workers_dev": true,
      "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "fintracka-snapshots-production" }],
      "d1_databases": [{
        "binding": "COMMANDS",
        "database_name": "fintracka-mobile-commands-production",
        "database_id": "edc2f4f4-9ec5-403a-8e2d-44dd42bacd07",
        "migrations_dir": "migrations"
      }],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "https://hidden-silence-257f.cloudflareaccess.com",
        "ACCESS_USER_AUD": "bf71b0fdb9bf64128200c065a58d67aea7047052d35da159a4a0631256c772d7",
        "ACCESS_MAC_AUD": "550252d3098e4d0bf22259cf9f98b71149433a565fae23bd6fd541199e9c20c5",
        "HOUSEHOLD_ID": "fintracka-household-v1",
        "HOUSEHOLD_NAME": "FinTracka household"
      }
    }
  }
}
