{
  "name": "fintracka-remote",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:deployment": "node scripts/check-mobile-command-deployment.ts",
    "deploy:publisher:staging": "wrangler deploy --config wrangler.publisher.jsonc --env staging",
    "deploy:publisher:production": "wrangler deploy --config wrangler.publisher.jsonc --env production",
    "deploy:viewer:staging": "wrangler deploy --config wrangler.viewer.jsonc --env staging",
    "deploy:viewer:production": "wrangler deploy --config wrangler.viewer.jsonc --env production"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "26.6.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
